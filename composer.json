{
  "name": "iquesters/foundation",
  "description": "A foundational package providing base classes and utilities for Laravel modules",
  "keywords": [
    "laravel",
    "modules",
    "modular",
    "settings",
    "api",
    "permissions",
    "iquesters"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/iquesters/foundation",
  "support": {
    "issues": "https://github.com/iquesters/foundation/issues",
    "source": "https://github.com/iquesters/foundation",
    "security": "https://github.com/iquesters/foundation/security/policy",
    "docs": "https://github.com/iquesters/foundation/tree/main/docs"
  },
  "authors": [
    {
      "name": "Pritam Bag",
      "email": "pritam02b@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "spatie/laravel-permission": "^8.0"
  },
  "suggest": {
    "iquesters/user-interface": "Stores generated form/table schemas (binds Foundation\\Contracts\\SchemaModels) and provides the UI",
    "iquesters/smart-messenger": "Required, with iquesters/integration, for the /api/dispatch-queue endpoint",
    "iquesters/integration": "Required, with iquesters/smart-messenger, for the /api/dispatch-queue endpoint"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "laravel/pint": "^1.18",
    "larastan/larastan": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Iquesters\\Foundation\\": "src/",
      "Iquesters\\Foundation\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Iquesters\\Foundation\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Iquesters\\Foundation\\FoundationServiceProvider"
      ]
    },
    "platform": {
      "api": {
        "prefix": "foundation",
        "versions": {
          "v1": "routes/api.v1.php"
        }
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
